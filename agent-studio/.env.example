# Copy to .env. Anything already exported in the environment wins over this file.

# Your Anthropic API key. You can also paste it into the Settings page instead,
# in which case it is stored in data/secrets.json rather than here.
ANTHROPIC_API_KEY=sk-ant-...

# Port for the API (and, once you have run `npm run build`, the UI).
PORT=4319

# Where workflows, runs, knowledge bases and secrets are written.
# Defaults to agent-studio/data.
# STUDIO_DATA_DIR=/absolute/path/to/data

# Secrets referenced from HTTP tool headers as {{env.NAME}} go here too, e.g.
# GITHUB_TOKEN=ghp_...
